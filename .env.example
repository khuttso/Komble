# Copy to ignored project/.env for local configuration, or use environment variables.
# Existing environment variables take precedence. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
OPENROUTER_VISION_MODEL=
